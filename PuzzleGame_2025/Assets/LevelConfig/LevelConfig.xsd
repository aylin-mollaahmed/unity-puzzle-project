<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- pieceShape: само Rect или Irregular -->
  <xs:simpleType name="PieceShapeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Rect"/>
      <xs:enumeration value="Irregular"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Difficulty id: 1..4 (както е в твоя файл) -->
  <xs:simpleType name="DifficultyIdType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="4"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Положително цяло (за shortSidePieces, piecePoint, maxUses) -->
  <xs:simpleType name="PositiveInt">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Ненегативно цяло (за costPoints) -->
  <xs:simpleType name="NonNegativeInt">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:element name="GameConfig">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Difficulties">
          <xs:complexType>
            <xs:sequence>
              <!-- 1 или повече Difficulty -->
              <xs:element name="Difficulty" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <!-- Help е задължителен в твоя XML -->
                    <xs:element name="Help" minOccurs="1" maxOccurs="1">
                      <xs:complexType>
                        <xs:attribute name="enabled" type="xs:boolean" use="required"/>
                        <xs:attribute name="maxUses" type="PositiveInt" use="required"/>
                        <xs:attribute name="costPoints" type="NonNegativeInt" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>

                  <xs:attribute name="id" type="DifficultyIdType" use="required"/>
                  <xs:attribute name="pieceShape" type="PieceShapeType" use="required"/>
                  <xs:attribute name="randomOrientation" type="xs:boolean" use="required"/>
                  <xs:attribute name="shortSidePieces" type="PositiveInt" use="required"/>
                  <xs:attribute name="piecePoint" type="PositiveInt" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>

            <!-- уникално id за Difficulty (да няма 2 Difficulty с едно и също id) -->
            <xs:unique name="UniqueDifficultyId">
              <xs:selector xpath="Difficulty"/>
              <xs:field xpath="@id"/>
            </xs:unique>

          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
